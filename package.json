{
  "name": "threejs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:data && next dev",
    "build": "npm run build:data && next build",
    "build:data": "node scripts/build-data.mjs && node scripts/build-atlas.mjs && node scripts/build-scenarios.mjs",
    "build:scenarios": "node scripts/build-scenarios.mjs",
    "build:reel": "node scripts/build-reel.mjs",
    "build:dispatches": "node scripts/build-dispatches.mjs",
    "build:preparedness": "node scripts/build-preparedness-geometry.mjs && node scripts/build-preparedness.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint-build": "npm run lint && npm run build"
  },
  "vercel": {
    "outputDirectory": ".next"
  },
  "dependencies": {
    "@headlessui/react": "^2.1.7",
    "@types/three": "^0.168.0",
    "chart.js": "^4.4.4",
    "headlessui": "^0.0.0",
    "next": "^14.2.11",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
